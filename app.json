{
  "id": "ua.te.its.vaillantebus",
  "version": "0.3.1",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Vaillant eBUS",
    "ru": "Vaillant eBUS",
    "uk": "Vaillant eBUS"
  },
  "description": {
    "en": "Local monitoring and control of Vaillant boilers over eBUS",
    "ru": "Локальный мониторинг и управление котлами Vaillant через eBUS",
    "uk": "Локальний моніторинг і керування котлами Vaillant через eBUS"
  },
  "category": [
    "climate"
  ],
  "brandColor": "#00917E",
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "author": {
    "name": "vova275",
    "email": "vova275@gmail.com"
  },
  "source": "https://github.com/vova275/homey-vaillant-ebus",
  "bugs": {
    "url": "https://github.com/vova275/homey-vaillant-ebus/issues"
  },
  "capabilities": {
    "measure_water_pressure": {
      "type": "number",
      "title": {
        "en": "Water pressure",
        "ru": "Давление воды",
        "uk": "Тиск води"
      },
      "units": {
        "en": "bar",
        "ru": "бар",
        "uk": "бар"
      },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/pressure.svg"
    },
    "measure_modulation": {
      "type": "number",
      "title": {
        "en": "Modulation",
        "ru": "Модуляция",
        "uk": "Модуляція"
      },
      "units": {
        "en": "%",
        "ru": "%",
        "uk": "%"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/modulation.svg"
    },
    "flame_on": {
      "type": "boolean",
      "title": {
        "en": "Flame",
        "ru": "Пламя",
        "uk": "Полум'я"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "insightsTitleTrue": {
        "en": "Flame on",
        "ru": "Пламя есть",
        "uk": "Полум'я є"
      },
      "insightsTitleFalse": {
        "en": "Flame off",
        "ru": "Пламени нет",
        "uk": "Полум'я немає"
      },
      "icon": "/assets/capabilities/flame.svg"
    },
    "hwc_demand": {
      "type": "boolean",
      "title": {
        "en": "Hot water demand",
        "ru": "Запрос горячей воды",
        "uk": "Запит гарячої води"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/tap.svg"
    },
    "bus_control": {
      "type": "boolean",
      "title": {
        "en": "Controlled by Homey",
        "ru": "Управление из Homey",
        "uk": "Керування з Homey"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "insights": false,
      "icon": "/assets/capabilities/control.svg",
      "desc": {
        "en": "On: Homey acts as the room controller and re-sends its setpoint every minute (overrides the boiler panel). Off: Homey only reads.",
        "ru": "Вкл.: Homey работает как комнатный регулятор и каждую минуту отправляет уставку (панель котла не действует). Выкл.: Homey только читает данные.",
        "uk": "Увімк.: Homey працює як кімнатний регулятор і щохвилини надсилає уставку (панель котла не діє). Вимк.: Homey лише читає дані."
      }
    },
    "boiler_error": {
      "type": "string",
      "title": {
        "en": "Error",
        "ru": "Ошибка",
        "uk": "Помилка"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/error.svg"
    },
    "heating_mode": {
      "type": "enum",
      "title": {
        "en": "Mode",
        "ru": "Режим",
        "uk": "Режим"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "comfort",
          "title": {
            "en": "Comfort",
            "ru": "Комфорт",
            "uk": "Комфорт"
          }
        },
        {
          "id": "eco",
          "title": {
            "en": "Eco",
            "ru": "Эко",
            "uk": "Еко"
          }
        },
        {
          "id": "away",
          "title": {
            "en": "Away (frost protection)",
            "ru": "Отъезд (защита от замерзания)",
            "uk": "Від'їзд (захист від замерзання)"
          }
        },
        {
          "id": "boost",
          "title": {
            "en": "Boost",
            "ru": "Буст",
            "uk": "Буст"
          }
        },
        {
          "id": "off",
          "title": {
            "en": "Heating off",
            "ru": "Отопление выключено",
            "uk": "Опалення вимкнено"
          }
        }
      ],
      "icon": "/assets/capabilities/control.svg"
    },
    "heating_active": {
      "type": "boolean",
      "title": {
        "en": "Heating requested",
        "ru": "Запрос на отопление",
        "uk": "Запит на опалення"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/flame.svg"
    },
    "alarm_water_pressure": {
      "type": "boolean",
      "title": {
        "en": "Low water pressure",
        "ru": "Низкое давление воды",
        "uk": "Низький тиск води"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/pressure.svg"
    },
    "measure_heat_power": {
      "type": "number",
      "title": {
        "en": "Heat output (estimated)",
        "ru": "Тепловая мощность (оценка)",
        "uk": "Теплова потужність (оцінка)"
      },
      "units": {
        "en": "kW",
        "ru": "кВт",
        "uk": "кВт"
      },
      "decimals": 1,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/modulation.svg"
    }
  },
  "drivers": [
    {
      "id": "boiler",
      "name": {
        "en": "Vaillant gas boiler",
        "ru": "Газовый котёл Vaillant",
        "uk": "Газовий котел Vaillant"
      },
      "class": "boiler",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "capabilities": [
        "target_temperature",
        "measure_temperature",
        "heating_mode",
        "bus_control",
        "heating_active",
        "target_temperature.flow",
        "measure_temperature.flow",
        "measure_temperature.return",
        "measure_temperature.outdoor",
        "target_temperature.hwc",
        "measure_temperature.hwc",
        "hwc_demand",
        "measure_water_pressure",
        "alarm_water_pressure",
        "flame_on",
        "measure_modulation",
        "measure_heat_power",
        "meter_gas",
        "alarm_generic",
        "boiler_error"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "title": {
            "en": "Room target",
            "ru": "Желаемая в комнате",
            "uk": "Бажана в кімнаті"
          },
          "min": 5,
          "max": 30,
          "step": 0.5
        },
        "measure_temperature": {
          "title": {
            "en": "Room temperature",
            "ru": "Температура в комнате",
            "uk": "Температура в кімнаті"
          }
        },
        "target_temperature.flow": {
          "title": {
            "en": "Heating flow setpoint",
            "ru": "Уставка подачи отопления",
            "uk": "Уставка подачі опалення"
          },
          "min": 20,
          "max": 80,
          "step": 1
        },
        "measure_temperature.flow": {
          "title": {
            "en": "Flow temperature",
            "ru": "Температура подачи",
            "uk": "Температура подачі"
          }
        },
        "measure_temperature.return": {
          "title": {
            "en": "Return temperature",
            "ru": "Температура обратки",
            "uk": "Температура зворотки"
          }
        },
        "measure_temperature.outdoor": {
          "title": {
            "en": "Outdoor temperature",
            "ru": "Температура на улице",
            "uk": "Температура на вулиці"
          }
        },
        "measure_temperature.hwc": {
          "title": {
            "en": "Hot water temperature",
            "ru": "Температура горячей воды",
            "uk": "Температура гарячої води"
          }
        },
        "target_temperature.hwc": {
          "title": {
            "en": "Hot water setpoint",
            "ru": "Уставка горячей воды",
            "uk": "Уставка гарячої води"
          },
          "min": 35,
          "max": 65,
          "step": 1
        },
        "meter_gas": {
          "title": {
            "en": "Gas (estimated)",
            "ru": "Газ (оценка)",
            "uk": "Газ (оцінка)"
          }
        },
        "alarm_generic": {
          "title": {
            "en": "Boiler fault",
            "ru": "Неисправность котла",
            "uk": "Несправність котла"
          }
        }
      },
      "images": {
        "small": "/drivers/boiler/assets/images/small.png",
        "large": "/drivers/boiler/assets/images/large.png"
      },
      "pair": [
        {
          "id": "connect"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection",
            "ru": "Подключение",
            "uk": "Підключення"
          },
          "children": [
            {
              "id": "transport",
              "type": "dropdown",
              "label": {
                "en": "Connection type",
                "ru": "Тип подключения",
                "uk": "Тип підключення"
              },
              "value": "ebusd",
              "values": [
                {
                  "id": "ebusd",
                  "label": {
                    "en": "ebusd daemon (TCP 8888, needs --enablehex)",
                    "ru": "Сервис ebusd (TCP 8888, нужен --enablehex)",
                    "uk": "Сервіс ebusd (TCP 8888, потрібен --enablehex)"
                  }
                },
                {
                  "id": "enhanced",
                  "label": {
                    "en": "Adapter, enhanced protocol (v5/v5-C6/ESP)",
                    "ru": "Адаптер, enhanced-протокол (v5/C5/C6/ESP)",
                    "uk": "Адаптер, enhanced-протокол (v5/C5/C6/ESP)"
                  }
                }
              ]
            },
            {
              "id": "host",
              "type": "text",
              "label": {
                "en": "Host / IP",
                "ru": "Хост / IP",
                "uk": "Хост / IP"
              },
              "value": ""
            },
            {
              "id": "port",
              "type": "number",
              "label": {
                "en": "Port",
                "ru": "Порт",
                "uk": "Порт"
              },
              "value": 8888,
              "min": 1,
              "max": 65535
            },
            {
              "id": "address",
              "type": "text",
              "label": {
                "en": "Own master address (hex, enhanced only)",
                "ru": "Свой адрес мастера (hex, только для адаптера)",
                "uk": "Власна адреса майстра (hex, лише для адаптера)"
              },
              "value": "31",
              "hint": {
                "en": "Must be a free eBUS master address. 31 is ebusd's default; do not use 10 if a Vaillant controller is on the bus.",
                "ru": "Должен быть свободный адрес мастера eBUS. 31 — по умолчанию в ebusd; не используйте 10, если на шине есть регулятор Vaillant.",
                "uk": "Має бути вільна адреса майстра eBUS. 31 — типова в ebusd; не використовуйте 10, якщо на шині є регулятор Vaillant."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Timing",
            "ru": "Интервалы",
            "uk": "Інтервали"
          },
          "children": [
            {
              "id": "poll_interval",
              "type": "number",
              "label": {
                "en": "Poll interval",
                "ru": "Интервал опроса",
                "uk": "Інтервал опитування"
              },
              "units": {
                "en": "s",
                "ru": "с",
                "uk": "с"
              },
              "value": 15,
              "min": 5,
              "max": 600
            },
            {
              "id": "control_interval",
              "type": "number",
              "label": {
                "en": "Setpoint refresh interval",
                "ru": "Интервал отправки уставки",
                "uk": "Інтервал надсилання уставки"
              },
              "units": {
                "en": "s",
                "ru": "с",
                "uk": "с"
              },
              "value": 60,
              "min": 15,
              "max": 600,
              "hint": {
                "en": "How often the setpoint is re-sent while Homey controls the boiler, like a room controller does.",
                "ru": "Как часто уставка отправляется повторно, пока Homey управляет котлом (как это делает комнатный регулятор).",
                "uk": "Як часто уставка надсилається повторно, поки Homey керує котлом (як це робить кімнатний регулятор)."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Heating regulation",
            "ru": "Регулирование отопления",
            "uk": "Регулювання опалення"
          },
          "children": [
            {
              "id": "regulation",
              "type": "dropdown",
              "label": {
                "en": "Regulation",
                "ru": "Регулирование",
                "uk": "Регулювання"
              },
              "value": "manual",
              "values": [
                {
                  "id": "manual",
                  "label": {
                    "en": "Manual flow setpoint",
                    "ru": "Ручная уставка подачи",
                    "uk": "Ручна уставка подачі"
                  }
                },
                {
                  "id": "curve",
                  "label": {
                    "en": "Weather curve + room sensors",
                    "ru": "Погодная кривая + комнатные датчики",
                    "uk": "Погодна крива + кімнатні датчики"
                  }
                }
              ],
              "hint": {
                "en": "Weather curve: the flow setpoint follows the outdoor temperature and is corrected by the room sensors chosen in the app settings.",
                "ru": "Погодная кривая: уставка подачи зависит от уличной температуры и корректируется комнатными датчиками, выбранными в настройках приложения.",
                "uk": "Погодна крива: уставка подачі залежить від вуличної температури й коригується кімнатними датчиками, вибраними в налаштуваннях застосунку."
              }
            },
            {
              "id": "curve_slope",
              "type": "number",
              "label": {
                "en": "Curve slope",
                "ru": "Наклон кривой",
                "uk": "Нахил кривої"
              },
              "value": 1.2,
              "min": 0.2,
              "max": 3.5,
              "hint": {
                "en": "Floor heating 0.4–0.8, radiators 1.0–1.6, poorly insulated 1.6–2.2.",
                "ru": "Тёплый пол 0,4–0,8, радиаторы 1,0–1,6, плохо утеплённый дом 1,6–2,2.",
                "uk": "Тепла підлога 0,4–0,8, радіатори 1,0–1,6, погано утеплений будинок 1,6–2,2."
              },
              "step": 0.1
            },
            {
              "id": "curve_shift",
              "type": "number",
              "label": {
                "en": "Curve shift",
                "ru": "Сдвиг кривой",
                "uk": "Зсув кривої"
              },
              "value": 0,
              "min": -15,
              "max": 15,
              "units": {
                "en": "°C",
                "ru": "°C",
                "uk": "°C"
              },
              "hint": {
                "en": "Moves the whole curve up or down.",
                "ru": "Сдвигает всю кривую вверх или вниз.",
                "uk": "Зсуває всю криву вгору або вниз."
              },
              "step": 0.5
            },
            {
              "id": "min_flow",
              "type": "number",
              "label": {
                "en": "Minimum flow temperature",
                "ru": "Минимальная температура подачи",
                "uk": "Мінімальна температура подачі"
              },
              "value": 25,
              "min": 15,
              "max": 50,
              "units": {
                "en": "°C",
                "ru": "°C",
                "uk": "°C"
              }
            },
            {
              "id": "max_flow",
              "type": "number",
              "label": {
                "en": "Maximum flow temperature",
                "ru": "Максимальная температура подачи",
                "uk": "Максимальна температура подачі"
              },
              "value": 65,
              "min": 30,
              "max": 85,
              "units": {
                "en": "°C",
                "ru": "°C",
                "uk": "°C"
              }
            },
            {
              "id": "heating_limit",
              "type": "number",
              "label": {
                "en": "Summer cut-off (outdoor)",
                "ru": "Летнее отключение (улица)",
                "uk": "Літнє вимкнення (вулиця)"
              },
              "value": 18,
              "min": 5,
              "max": 30,
              "units": {
                "en": "°C",
                "ru": "°C",
                "uk": "°C"
              },
              "hint": {
                "en": "No heating when it is this warm outside.",
                "ru": "Отопление не работает, если на улице так тепло.",
                "uk": "Опалення не працює, якщо на вулиці так тепло."
              },
              "step": 0.5
            },
            {
              "id": "room_gain",
              "type": "number",
              "label": {
                "en": "Room influence",
                "ru": "Влияние комнаты",
                "uk": "Вплив кімнати"
              },
              "value": 3,
              "min": 0,
              "max": 10,
              "units": {
                "en": "°C per K",
                "ru": "°C на K",
                "uk": "°C на K"
              },
              "hint": {
                "en": "How many degrees of flow per degree the room is off target.",
                "ru": "На сколько градусов меняется подача на каждый градус отклонения в комнате.",
                "uk": "На скільки градусів змінюється подача на кожен градус відхилення в кімнаті."
              },
              "step": 0.5
            },
            {
              "id": "room_integral",
              "type": "number",
              "label": {
                "en": "Room learning speed",
                "ru": "Скорость подстройки",
                "uk": "Швидкість підлаштування"
              },
              "value": 2,
              "min": 0,
              "max": 10,
              "units": {
                "en": "°C per K·h",
                "ru": "°C на K·ч",
                "uk": "°C на K·год"
              },
              "hint": {
                "en": "Slowly shifts the curve if the room stays too cold or too warm. 0 = off.",
                "ru": "Медленно сдвигает кривую, если в комнате постоянно холодно или жарко. 0 = выкл.",
                "uk": "Повільно зсуває криву, якщо в кімнаті постійно холодно або спекотно. 0 = вимк."
              },
              "step": 0.5
            },
            {
              "id": "room_hyst",
              "type": "number",
              "label": {
                "en": "Room overshoot before heating stops",
                "ru": "Перегрев комнаты до отключения отопления",
                "uk": "Перегрів кімнати до вимкнення опалення"
              },
              "value": 0.5,
              "min": 0.1,
              "max": 3,
              "units": {
                "en": "°C",
                "ru": "°C",
                "uk": "°C"
              },
              "step": 0.1
            },
            {
              "id": "valve_delay",
              "type": "number",
              "label": {
                "en": "Valve opening delay",
                "ru": "Задержка открытия клапанов",
                "uk": "Затримка відкриття клапанів"
              },
              "value": 2,
              "min": 0,
              "max": 10,
              "units": {
                "en": "min",
                "ru": "мин",
                "uk": "хв"
              },
              "hint": {
                "en": "Zone valves (app settings): heating starts this long after the first valve opens, so the actuators are open before the pump pushes water.",
                "ru": "Клапаны зон (настройки приложения): отопление включается через это время после открытия первого клапана, чтобы сервоприводы успели открыться.",
                "uk": "Клапани зон (налаштування застосунку): опалення вмикається через цей час після відкриття першого клапана, щоб сервоприводи встигли відкритися."
              }
            },
            {
              "id": "no_demand",
