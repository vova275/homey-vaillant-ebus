{
  "id": "ua.te.its.vaillantebus",
  "version": "0.2.0",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Vaillant eBUS"
  },
  "description": {
    "en": "Local monitoring and control of Vaillant boilers over eBUS"
  },
  "category": [
    "climate"
  ],
  "brandColor": "#00917E",
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "author": {
    "name": "vova275",
    "email": "vova275@gmail.com"
  },
  "source": "https://github.com/vova275/homey-vaillant-ebus",
  "bugs": {
    "url": "https://github.com/vova275/homey-vaillant-ebus/issues"
  },
  "capabilities": {
    "measure_water_pressure": {
      "type": "number",
      "title": {
        "en": "Water pressure"
      },
      "units": {
        "en": "bar"
      },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/pressure.svg"
    },
    "measure_modulation": {
      "type": "number",
      "title": {
        "en": "Modulation"
      },
      "units": {
        "en": "%"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/modulation.svg"
    },
    "flame_on": {
      "type": "boolean",
      "title": {
        "en": "Flame"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "insightsTitleTrue": {
        "en": "Flame on"
      },
      "insightsTitleFalse": {
        "en": "Flame off"
      },
      "icon": "/assets/capabilities/flame.svg"
    },
    "hwc_demand": {
      "type": "boolean",
      "title": {
        "en": "Hot water demand"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/tap.svg"
    },
    "bus_control": {
      "type": "boolean",
      "title": {
        "en": "Controlled by Homey"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "insights": false,
      "icon": "/assets/capabilities/control.svg",
      "desc": {
        "en": "On: Homey acts as the room controller and re-sends its setpoint every minute (overrides the boiler panel). Off: Homey only reads."
      }
    },
    "boiler_error": {
      "type": "string",
      "title": {
        "en": "Error"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/error.svg"
    },
    "heating_mode": {
      "type": "enum",
      "title": {
        "en": "Mode"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "comfort",
          "title": {
            "en": "Comfort"
          }
        },
        {
          "id": "eco",
          "title": {
            "en": "Eco"
          }
        },
        {
          "id": "away",
          "title": {
            "en": "Away (frost protection)"
          }
        },
        {
          "id": "boost",
          "title": {
            "en": "Boost"
          }
        },
        {
          "id": "off",
          "title": {
            "en": "Heating off"
          }
        }
      ],
      "icon": "/assets/capabilities/control.svg"
    },
    "heating_active": {
      "type": "boolean",
      "title": {
        "en": "Heating requested"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/flame.svg"
    },
    "alarm_water_pressure": {
      "type": "boolean",
      "title": {
        "en": "Low water pressure"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/pressure.svg"
    },
    "measure_heat_power": {
      "type": "number",
      "title": {
        "en": "Heat output (estimated)"
      },
      "units": {
        "en": "kW"
      },
      "decimals": 1,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/modulation.svg"
    }
  },
  "drivers": [
    {
      "id": "boiler",
      "name": {
        "en": "Vaillant gas boiler"
      },
      "class": "thermostat",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "capabilities": [
        "target_temperature",
        "measure_temperature",
        "heating_mode",
        "bus_control",
        "heating_active",
        "target_temperature.flow",
        "measure_temperature.flow",
        "measure_temperature.return",
        "measure_temperature.outdoor",
        "target_temperature.hwc",
        "measure_temperature.hwc",
        "hwc_demand",
        "measure_water_pressure",
        "alarm_water_pressure",
        "flame_on",
        "measure_modulation",
        "measure_heat_power",
        "meter_gas",
        "alarm_generic",
        "boiler_error"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "title": {
            "en": "Room target"
          },
          "min": 5,
          "max": 30,
          "step": 0.5
        },
        "measure_temperature": {
          "title": {
            "en": "Room temperature"
          }
        },
        "target_temperature.flow": {
          "title": {
            "en": "Heating flow setpoint"
          },
          "min": 20,
          "max": 80,
          "step": 1
        },
        "measure_temperature.flow": {
          "title": {
            "en": "Flow temperature"
          }
        },
        "measure_temperature.return": {
          "title": {
            "en": "Return temperature"
          }
        },
        "measure_temperature.outdoor": {
          "title": {
            "en": "Outdoor temperature"
          }
        },
        "measure_temperature.hwc": {
          "title": {
            "en": "Hot water temperature"
          }
        },
        "target_temperature.hwc": {
          "title": {
            "en": "Hot water setpoint"
          },
          "min": 35,
          "max": 65,
          "step": 1
        },
        "meter_gas": {
          "title": {
            "en": "Gas (estimated)"
          }
        },
        "alarm_generic": {
          "title": {
            "en": "Boiler fault"
          }
        }
      },
      "images": {
        "small": "/drivers/boiler/assets/images/small.png",
        "large": "/drivers/boiler/assets/images/large.png"
      },
      "pair": [
        {
          "id": "connect"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection"
          },
          "children": [
            {
              "id": "transport",
              "type": "dropdown",
              "label": {
                "en": "Connection type"
              },
              "value": "ebusd",
              "values": [
                {
                  "id": "ebusd",
                  "label": {
                    "en": "ebusd daemon (TCP 8888, needs --enablehex)"
                  }
                },
                {
                  "id": "enhanced",
                  "label": {
                    "en": "Adapter, enhanced protocol (v5/v5-C6/ESP)"
                  }
                }
              ]
            },
            {
              "id": "host",
              "type": "text",
              "label": {
                "en": "Host / IP"
              },
              "value": ""
            },
            {
              "id": "port",
              "type": "number",
              "label": {
                "en": "Port"
              },
              "value": 8888,
              "min": 1,
              "max": 65535
            },
            {
              "id": "address",
              "type": "text",
              "label": {
                "en": "Own master address (hex, enhanced only)"
              },
              "value": "31",
              "hint": {
                "en": "Must be a free eBUS master address. 31 is ebusd's default; do not use 10 if a Vaillant controller is on the bus."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Timing"
          },
          "children": [
            {
              "id": "poll_interval",
              "type": "number",
              "label": {
                "en": "Poll interval"
              },
              "units": {
                "en": "s"
              },
              "value": 15,
              "min": 5,
              "max": 600
            },
            {
              "id": "control_interval",
              "type": "number",
              "label": {
                "en": "Setpoint refresh interval"
              },
              "units": {
                "en": "s"
              },
              "value": 60,
              "min": 15,
              "max": 600,
              "hint": {
                "en": "How often the setpoint is re-sent while Homey controls the boiler, like a room controller does."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Heating regulation"
          },
          "children": [
            {
              "id": "regulation",
              "type": "dropdown",
              "label": {
                "en": "Regulation"
              },
              "value": "manual",
              "values": [
                {
                  "id": "manual",
                  "label": {
                    "en": "Manual flow setpoint"
                  }
                },
                {
                  "id": "curve",
                  "label": {
                    "en": "Weather curve + room sensors"
                  }
                }
              ],
              "hint": {
                "en": "Weather curve: the flow setpoint follows the outdoor temperature and is corrected by the room sensors chosen in the app settings."
              }
            },
            {
              "id": "curve_slope",
              "type": "number",
              "label": {
                "en": "Curve slope"
              },
              "value": 1.2,
              "min": 0.2,
              "max": 3.5,
              "hint": {
                "en": "Floor heating 0.4–0.8, radiators 1.0–1.6, poorly insulated 1.6–2.2."
              },
              "step": 0.1
            },
            {
              "id": "curve_shift",
              "type": "number",
              "label": {
                "en": "Curve shift"
              },
              "value": 0,
              "min": -15,
              "max": 15,
              "units": {
                "en": "°C"
              },
              "hint": {
                "en": "Moves the whole curve up or down."
              },
              "step": 0.5
            },
            {
              "id": "min_flow",
              "type": "number",
              "label": {
                "en": "Minimum flow temperature"
              },
              "value": 25,
              "min": 15,
              "max": 50,
              "units": {
                "en": "°C"
              }
            },
            {
              "id": "max_flow",
              "type": "number",
              "label": {
                "en": "Maximum flow temperature"
              },
              "value": 65,
              "min": 30,
              "max": 85,
              "units": {
                "en": "°C"
              }
            },
            {
              "id": "heating_limit",
              "type": "number",
              "label": {
                "en": "Summer cut-off (outdoor)"
              },
              "value": 18,
              "min": 5,
              "max": 30,
              "units": {
                "en": "°C"
              },
              "hint": {
                "en": "No heating when it is this warm outside."
              },
              "step": 0.5
            },
            {
              "id": "room_gain",
              "type": "number",
              "label": {
                "en": "Room influence"
              },
              "value": 3,
              "min": 0,
              "max": 10,
              "units": {
                "en": "°C per K"
              },
              "hint": {
                "en": "How many degrees of flow per degree the room is off target."
              },
              "step": 0.5
            },
            {
              "id": "room_integral",
              "type": "number",
              "label": {
                "en": "Room learning speed"
              },
              "value": 2,
              "min": 0,
              "max": 10,
              "units": {
                "en": "°C per K·h"
              },
              "hint": {
                "en": "Slowly shifts the curve if the room stays too cold or too warm. 0 = off."
              },
              "step": 0.5
            },
            {
              "id": "room_hyst",
              "type": "number",
              "label": {
                "en": "Room overshoot before heating stops"
              },
              "value": 0.5,
              "min": 0.1,
              "max": 3,
              "units": {
                "en": "°C"
              },
              "step": 0.1
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Modes"
          },
          "children": [
            {
              "id": "eco_delta",
              "type": "number",
              "label": {
                "en": "Eco: lower room target by"
              },
              "value": 3,
              "min": 0.5,
              "max": 10,
              "units": {
                "en": "°C"
              },
              "step": 0.5
            },
            {
              "id": "away_temp",
              "type": "number",
              "label": {
                "en": "Away: room temperature"
              },
              "value": 10,
              "min": 5,
              "max": 18,
              "units": {
                "en": "°C"
              },
              "step": 0.5
            },
            {
              "id": "boost_flow",
              "type": "number",
              "label": {
                "en": "Boost: flow temperature"
              },
              "value": 70,
              "min": 40,
              "max": 85,
              "units": {
                "en": "°C"
              }
            },
            {
              "id": "boost_minutes",
              "type": "number",
              "label": {
                "en": "Boost: duration"
              },
              "value": 30,
              "min": 5,
              "max": 240,
              "units": {
                "en": "min"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Alarms"
          },
          "children": [
            {
              "id": "pressure_min",
              "type": "number",
              "label": {
                "en": "Low water pressure alarm below"
              },
              "value": 1,
              "min": 0.3,
              "max": 2.5,
              "units": {
                "en": "bar"
              },
              "step": 0.1
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Gas estimate"
          },
          "children": [
            {
              "id": "max_kw",
              "type": "number",
              "label": {
                "en": "Nominal heat output"
              },
              "value": 24,
              "min": 5,
              "max": 100,
              "units": {
                "en": "kW"
              },
              "hint": {
                "en": "From the type plate, e.g. VU 246 = 24 kW."
              }
            },
            {
              "id": "min_kw",
              "type": "number",
              "label": {
                "en": "Minimum heat output"
              },
              "value": 8,
              "min": 1,
              "max": 30,
              "units": {
                "en": "kW"
              }
            },
            {
              "id": "kwh_per_m3",
              "type": "number",
              "label": {
                "en": "Gas energy content"
              },
              "value": 9.5,
              "min": 7,
              "max": 12,
              "units": {
                "en": "kWh/m³"
              },
              "step": 0.1
            },
            {
              "id": "efficiency",
              "type": "number",
              "label": {
                "en": "Efficiency"
              },
              "value": 95,
              "min": 70,
              "max": 110,
              "units": {
                "en": "%"
              }
            }
          ]
        }
      ]
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "flame_on",
        "title": {
          "en": "Flame turned on"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          }
        ]
      },
      {
        "id": "flame_off",
        "title": {
          "en": "Flame turned off"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          }
        ]
      },
      {
        "id": "error_changed",
        "title": {
          "en": "Boiler error changed"
        },
        "tokens": [
          {
            "name": "error",
            "type": "string",
            "title": {
              "en": "Error"
            },
            "example": {
              "en": "F.28"
            }
          },
          {
            "name": "active",
            "type": "boolean",
            "title": {
              "en": "Fault active"
            }
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          }
        ]
      },
      {
        "id": "pressure_changed",
        "title": {
          "en": "Water pressure changed"
        },
        "tokens": [
          {
            "name": "pressure",
            "type": "number",
            "title": {
              "en": "Pressure (bar)"
            },
            "example": 1.6
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          }
        ]
      },
      {
        "id": "pressure_low",
        "title": {
          "en": "Water pressure dropped below the alarm level"
        },
        "tokens": [
          {
            "name": "pressure",
            "type": "number",
            "title": {
              "en": "Pressure (bar)"
            },
            "example": 0.9
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          }
        ]
      },
      {
        "id": "pressure_ok",
        "title": {
          "en": "Water pressure back to normal"
        },
        "tokens": [
          {
            "name": "pressure",
            "type": "number",
            "title": {
              "en": "Pressure (bar)"
            },
            "example": 1.5
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          }
        ]
      },
      {
        "id": "mode_changed",
        "title": {
          "en": "Mode changed"
        },
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode"
            },
            "example": "eco"
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "flame_is_on",
        "title": {
          "en": "Flame is !{{on|off}}"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          }
        ]
      },
      {
        "id": "pressure_below",
        "title": {
          "en": "Water pressure is !{{below|above}}"
        },
        "titleFormatted": {
          "en": "Water pressure is !{{below|above}} [[bar]] bar"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          },
          {
            "name": "bar",
            "type": "number",
            "min": 0,
            "max": 4,
            "step": 0.1,
            "placeholder": {
              "en": "1.0"
            }
          }
        ]
      },
      {
        "id": "mode_is",
        "title": {
          "en": "Mode !{{is|is not}}"
        },
        "titleFormatted": {
          "en": "Mode !{{is|is not}} [[mode]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "values": [
              {
                "id": "comfort",
                "label": {
                  "en": "Comfort"
                }
              },
              {
                "id": "eco",
                "label": {
                  "en": "Eco"
                }
              },
              {
                "id": "away",
                "label": {
                  "en": "Away (frost protection)"
                }
              },
              {
                "id": "boost",
                "label": {
                  "en": "Boost"
                }
              },
              {
                "id": "off",
                "label": {
                  "en": "Heating off"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "pressure_is_low",
        "title": {
          "en": "Water pressure !{{is|is not}} low"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_flow_temperature",
        "title": {
          "en": "Set heating flow setpoint"
        },
        "titleFormatted": {
          "en": "Set heating flow setpoint to [[temperature]] °C"
        },
        "hint": {
          "en": "Also switches on control by Homey."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          },
          {
            "name": "temperature",
            "type": "number",
            "min": 20,
            "max": 80,
            "step": 1
          }
        ]
      },
      {
        "id": "set_hwc_temperature",
        "title": {
          "en": "Set hot water setpoint"
        },
        "titleFormatted": {
          "en": "Set hot water setpoint to [[temperature]] °C"
        },
        "hint": {
          "en": "Also switches on control by Homey."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          },
          {
            "name": "temperature",
            "type": "number",
            "min": 35,
            "max": 65,
            "step": 1
          }
        ]
      },
      {
        "id": "set_bus_control",
        "title": {
          "en": "Turn control by Homey"
        },
        "titleFormatted": {
          "en": "Turn control by Homey [[state]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          },
          {
            "name": "state",
            "type": "dropdown",
            "values": [
              {
                "id": "on",
                "label": {
                  "en": "on"
                }
              },
              {
                "id": "off",
                "label": {
                  "en": "off (boiler panel)"
                }
